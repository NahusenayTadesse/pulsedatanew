# Drizzle
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

# The URL this deployment actually answers on, e.g. https://pulsedata.et
# adapter-node rejects form POSTs whose origin does not match this, so every
# form on the site fails without it. Also used for image URLs inside emails.
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Where uploads are written. Public files are served from /files; private ones
# (contact-form attachments) go in the `private` subfolder. Point this at a
# volume OUTSIDE the deploy directory, or a redeploy deletes every upload.
FILES_DIR=""

# SMTP. Without these the site still records enquiries, but sends nothing —
# no acknowledgement to the sender and no notification to the team.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# The address recipients see, e.g. "Pulsedata Solutions <hello@pulsedata.et>".
# Defaults to SMTP_USER.
MAIL_FROM=""

# Where new-enquiry notifications are sent. Defaults to MAIL_FROM.
MAIL_TO=""

# A blind copy of everything a person here sends — dashboard replies, the
# general composer, outbound proposals. Sending over SMTP writes nothing to
# webmail's Sent folder (that folder is written by webmail itself), so without
# this there is no record in the mailbox that a message was ever sent.
MAIL_ARCHIVE=""
